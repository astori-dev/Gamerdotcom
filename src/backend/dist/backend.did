type _ImmutableObjectStorageRefillResult = 
 record {
   success: opt bool;
   topped_up_amount: opt nat;
 };
type _ImmutableObjectStorageRefillInformation = record {
                                                  proposed_top_up_amount:
                                                   opt nat;};
type _ImmutableObjectStorageCreateCertificateResult = 
 record {
   blob_hash: text;
   method: text;
 };
type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type UserProfileResponse = 
 record {
   bio: text;
   createdAt: Time;
   displayName: text;
   followersCount: nat;
   followingCount: nat;
   headerImageHash: opt ExternalBlob;
   isBlockedByCurrentUser: bool;
   isFollowedByCurrentUser: bool;
   isMutedByCurrentUser: bool;
   postsCount: nat;
   "principal": principal;
   profilePictureHash: opt ExternalBlob;
   updatedAt: Time;
   username: text;
 };
type UserProfile = 
 record {
   bio: text;
   createdAt: Time;
   displayName: text;
   headerImageHash: opt ExternalBlob;
   profilePictureHash: opt ExternalBlob;
   updatedAt: Time;
   username: text;
 };
type TrendingHashtag = 
 record {
   count: nat;
   tag: text;
 };
type Time = int;
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type PostType = 
 variant {
   original;
   quote: nat;
   reply: nat;
   repost: nat;
 };
type PostResponse = 
 record {
   author: principal;
   authorDisplayName: text;
   authorProfilePictureHash: opt ExternalBlob;
   authorUsername: text;
   createdAt: Time;
   editedAt: opt Time;
   id: nat;
   isLikedByCurrentUser: bool;
   isRepostedByCurrentUser: bool;
   likeCount: nat;
   mediaHash: opt ExternalBlob;
   mediaType: opt text;
   postType: PostType;
   replyCount: nat;
   repostCount: nat;
   "text": text;
 };
type PaginatedPosts = 
 record {
   hasMore: bool;
   nextCursor: opt nat;
   posts: vec PostResponse;
 };
type PaginatedNotifications = 
 record {
   hasMore: bool;
   nextCursor: opt nat;
   notifications: vec Notification;
 };
type PaginatedGroups = 
 record {
   groups: vec GroupSummary;
   hasMore: bool;
   nextCursor: opt nat;
 };
type PaginatedGroupPosts = 
 record {
   hasMore: bool;
   nextCursor: opt nat;
   posts: vec GroupPost;
 };
type PaginatedFollows = 
 record {
   hasMore: bool;
   nextOffset: opt nat;
   users: vec FollowUserResponse;
 };
type NotificationType = 
 variant {
   follow;
   like: nat;
   mention: nat;
   quote: nat;
   reply: nat;
   repost: nat;
 };
type Notification = 
 record {
   actorPrincipal: principal;
   actorUsername: text;
   createdAt: Time;
   id: nat;
   isRead: bool;
   notificationType: NotificationType;
 };
type GroupSummary = 
 record {
   communityId: CommunityId;
   coverImageHash: opt ExternalBlob;
   description: text;
   id: GroupId;
   memberCount: nat;
   name: text;
 };
type GroupPost = 
 record {
   author: principal;
   createdAt: Time;
   groupId: GroupId;
   id: nat;
   mediaHash: opt ExternalBlob;
   mediaType: opt text;
   "text": text;
 };
type GroupMember = 
 record {
   joinedAt: Time;
   "principal": principal;
 };
type GroupId = nat;
type Group = 
 record {
   communityId: CommunityId;
   coverImageHash: opt ExternalBlob;
   createdAt: Time;
   creator: principal;
   description: text;
   id: GroupId;
   name: text;
 };
type FollowUserResponse = 
 record {
   displayName: text;
   "principal": principal;
   profilePictureHash: opt ExternalBlob;
   username: text;
 };
type ExternalBlob = blob;
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type CommunitySummary = 
 record {
   coverImageHash: opt ExternalBlob;
   description: text;
   groupCount: nat;
   id: CommunityId;
   name: text;
 };
type CommunityId = nat;
type Community = 
 record {
   coverImageHash: opt ExternalBlob;
   createdAt: Time;
   creator: principal;
   description: text;
   id: CommunityId;
   name: text;
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  __accessControlState: () -> (reserved) query;
  __blocks: () -> (reserved) query;
  __communitiesGroupsState: () -> (reserved) query;
  __followers: () -> (reserved) query;
  __following: () -> (reserved) query;
  __hashtagIndex: () -> (reserved) query;
  __mutes: () -> (reserved) query;
  __nextNotificationId: () -> (nat) query;
  __nextPostId: () -> (nat) query;
  __postLikes: () -> (reserved) query;
  __postReplies: () -> (reserved) query;
  __postReposts: () -> (reserved) query;
  __posts: () -> (reserved) query;
  __repostIndex: () -> (reserved) query;
  __userNotifications: () -> (reserved) query;
  __userPostCounts: () -> (reserved) query;
  __userProfiles: () -> (reserved) query;
  __usernameToUser: () -> (reserved) query;
  _immutableObjectStorageBlobsAreLive: (hashes: vec blob) -> (vec bool) query;
  _immutableObjectStorageBlobsToDelete: () -> (vec blob) query;
  _immutableObjectStorageConfirmBlobDeletion: (blobs: vec blob) -> ();
  _immutableObjectStorageCreateCertificate: (blobHash: text) ->
   (_ImmutableObjectStorageCreateCertificateResult);
  _immutableObjectStorageRefillCashier: (refillInformation:
   opt _ImmutableObjectStorageRefillInformation) ->
   (_ImmutableObjectStorageRefillResult);
  _immutableObjectStorageUpdateGatewayPrincipals: () -> ();
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  blockUser: (user: principal) -> ();
  checkUsernameAvailability: (username: text) -> (bool) query;
  createCommunity: (name: text, description: text, coverImageHash:
   opt ExternalBlob) -> (Community);
  createGroup: (communityId: CommunityId, name: text, description: text,
   coverImageHash: opt ExternalBlob) -> (Group);
  createGroupPost: (groupId: GroupId, "text": text, mediaHash:
   opt ExternalBlob, mediaType: opt text) -> (GroupPost);
  createPost: ("text": text, mediaHash: opt ExternalBlob, mediaType:
   opt text) -> (PostResponse);
  createReply: (parentPostId: nat, "text": text, mediaHash: opt ExternalBlob,
   mediaType: opt text) -> (PostResponse);
  deletePost: (postId: nat) -> ();
  editPost: (postId: nat, "text": text) -> (PostResponse);
  execute: (qJson: text) -> (Result) query;
  followUser: (user: principal) -> ();
  getCallerUserRole: () -> (UserRole) query;
  getCommunity: (id: CommunityId) -> (opt Community) query;
  getFollowers: (username: text, offset: nat, limit: nat) ->
   (PaginatedFollows) query;
  getFollowing: (username: text, offset: nat, limit: nat) ->
   (PaginatedFollows) query;
  getGlobalFeed: (cursor: opt nat, limit: nat) -> (PaginatedPosts) query;
  getGroup: (id: GroupId) -> (opt Group) query;
  getGroupFeed: (groupId: GroupId, cursor: opt nat, limit: nat) ->
   (PaginatedGroupPosts) query;
  getGroupMembers: (groupId: GroupId, offset: nat, limit: nat) ->
   (vec GroupMember) query;
  getGroupPost: (postId: nat) -> (opt GroupPost) query;
  getHomeFeed: (cursor: opt nat, limit: nat) -> (PaginatedPosts) query;
  getNotifications: (cursor: opt nat, limit: nat) ->
   (PaginatedNotifications) query;
  getPost: (postId: nat) -> (opt PostResponse) query;
  getPostsByHashtag: (tag: text, cursor: opt nat, limit: nat) ->
   (PaginatedPosts) query;
  getPostsByUser: (user: principal, cursor: opt nat, limit: nat) ->
   (PaginatedPosts) query;
  getPostsByUsername: (username: text, cursor: opt nat, limit: nat) ->
   (PaginatedPosts) query;
  getPrincipalByUsername: (username: text) -> (opt principal) query;
  getProfile: () -> (opt UserProfile) query;
  getProfileByUsername: (username: text) -> (opt UserProfileResponse) query;
  getReplies: (postId: nat, cursor: opt nat, limit: nat) ->
   (PaginatedPosts) query;
  getTrendingHashtags: (limit: nat) -> (vec TrendingHashtag) query;
  getUnreadNotificationCount: () -> (nat) query;
  getUserProfile: (user: principal) -> (opt UserProfileResponse) query;
  isCallerAdmin: () -> (bool) query;
  isGroupMember: (groupId: GroupId, member: principal) -> (bool) query;
  joinGroup: (groupId: GroupId) -> ();
  leaveGroup: (groupId: GroupId) -> ();
  likePost: (postId: nat) -> ();
  listCommunities: (cursor: opt nat, limit: nat) ->
   (vec CommunitySummary) query;
  listGroupsByCommunity: (communityId: CommunityId, cursor: opt nat, limit:
   nat) -> (PaginatedGroups) query;
  markAllNotificationsRead: () -> ();
  markNotificationRead: (notifId: nat) -> ();
  muteUser: (user: principal) -> ();
  quotePost: (postId: nat, "text": text, mediaHash: opt ExternalBlob,
   mediaType: opt text) -> (PostResponse);
  repostPost: (postId: nat) -> (PostResponse);
  schema: () -> (text) query;
  searchCommunities: (searchText: text, limit: nat) ->
   (vec CommunitySummary) query;
  searchGroups: (searchText: text, limit: nat) -> (vec GroupSummary) query;
  searchPosts: (searchText: text, cursor: opt nat, limit: nat) ->
   (PaginatedPosts) query;
  searchUsers: (searchText: text, limit: nat) ->
   (vec UserProfileResponse) query;
  setProfile: (username: text, displayName: text, bio: text) -> ();
  unblockUser: (user: principal) -> ();
  undoRepost: (postId: nat) -> ();
  unfollowUser: (user: principal) -> ();
  unlikePost: (postId: nat) -> ();
  unmuteUser: (user: principal) -> ();
  updateHeaderImage: (imageHash: opt ExternalBlob) -> ();
  updateProfilePicture: (pictureHash: opt ExternalBlob) -> ();
}
